{
  "name": "@settlize/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Settlize backend — Hono + Drizzle + Postgres (TypeScript). API, WebSockets, offline sync, FX cron.",
  "license": "MIT",
  "author": "Saveliy Shiryaev",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:reset": "podman compose down -v && podman compose up -d",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "better-auth": "^1.6.29",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
